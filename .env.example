# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.
# The server must be restarted after changing any of these.

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/med-app-reminder

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ random characters. Also used (via a derived key) to sign password-
# reset session tokens — see lib/resetSession.ts.
JWT_SECRET=

# Optional — if unset, derived from JWT_SECRET. Set explicitly in
# production so reset-code hashing has its own dedicated secret.
RESET_CODE_SECRET=

# ── App URL ─────────────────────────────────────────────────────────────
# Used to build the clickable link in password-reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMTP / Email (password reset delivery) ─────────────────────────────
# Required for password-reset emails to actually send. If any of
# SMTP_HOST / SMTP_USER / SMTP_PASS are missing, the app falls back to
# logging the code to the server console in development, and fails closed
# (no email sent, but the API still returns success to avoid account
# enumeration) in production.
#
# ── Using Gmail? ──
# Gmail will NOT accept your normal account password here — you'll get a
# "535-5.7.8 Username and Password not accepted" / EAUTH error, which is
# exactly what nodemailer surfaces when this is misconfigured. Instead:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password (16 characters, no spaces when you paste
#      it here): https://myaccount.google.com/apppasswords
#   3. Use that App Password as SMTP_PASS below — not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false for port 587 (STARTTLS) — set to true only if using port 465.
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
# Gmail App Password (16 chars), not your normal account password.
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=your-address@gmail.com

# ── Web Push (optional feature) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com