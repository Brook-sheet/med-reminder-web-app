# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# Restart npm run dev after changing environment variables.

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/med-app-reminder

# ── Authentication ─────────────────────────────────────────────────────
# Use at least 32 random characters.
JWT_SECRET=

# Optional. If missing, the application derives this from JWT_SECRET.
RESET_CODE_SECRET=

# ── Application URL ────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_URL=https://med-reminder-web-app-xi.vercel.app

# ── Rx Box hardware: private/server-only ───────────────────────────────
SENSOR_API_KEY=

# Must match DEVICE_ID in the Arduino firmware.
RX_BOX_DEVICE_ID=box_1

# MongoDB _id of the patient assigned to box_1.
DEFAULT_DEVICE_USER_ID=

MEDICATION_TIME_ZONE=Asia/Manila

# ── SMTP/email ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=
SMTP_FROM=your-address@gmail.com

# ── Web Push ───────────────────────────────────────────────────────────
# Public browser configuration.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private/server-only.
VAPID_PRIVATE_KEY=

VAPID_SUBJECT=mailto:you@example.com

# ── Family SMS alerts ──────────────────────────────────────────────────
# Supported values: textbee, twilio, or disabled.


# TextBee: sensitive/private/server-only.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Optional. Leave empty to use https://api.textbee.dev.
TEXTBEE_API_BASE_URL=

# Request timeout in milliseconds.
SMS_REQUEST_TIMEOUT_MS=10000

# Optional Twilio fallback: sensitive/private/server-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=