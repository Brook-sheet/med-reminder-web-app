# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it should remain in .gitignore.
# Restart the development server after changing environment variables.

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/med-app-reminder

# ── Authentication ─────────────────────────────────────────────────────
# Use at least 32 random characters.
JWT_SECRET=

# Optional. If missing, the application derives this from JWT_SECRET.
# Configure it separately in production for stronger key separation.
RESET_CODE_SECRET=

# ── Application URL ────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_URL=https://med-reminder-web-app-xi.vercel.app

# ── Rx Box hardware: private server-only variables ─────────────────────
# Generate a long random secret.
# Enter the exact same value in the final Arduino .ino file.
# Never add NEXT_PUBLIC_ to any variable in this section.
SENSOR_API_KEY=

# Single supported physical device.
# Must match DEVICE_ID in medicine-carousel.ino.
RX_BOX_DEVICE_ID=box_1

# MongoDB _id of the patient account assigned to box_1.
# Only one complete 24-character patient ObjectId is allowed.
DEFAULT_DEVICE_USER_ID=

# Timezone used for daily loading plans and medication windows.
MEDICATION_TIME_ZONE=Asia/Manila

# ── SMTP / email ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Use false for port 587 and true for port 465.
SMTP_SECURE=false

SMTP_USER=your-address@gmail.com

# For Gmail, use a Google App Password, not the normal account password.
SMTP_PASS=

# Optional. Defaults to SMTP_USER when missing.
SMTP_FROM=your-address@gmail.com

# ── Web Push ───────────────────────────────────────────────────────────
# This public VAPID key is intentionally available to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private server-only VAPID key.
VAPID_PRIVATE_KEY=

# Example: mailto:admin@example.com
VAPID_SUBJECT=mailto:you@example.com